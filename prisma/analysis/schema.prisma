// 本 schema 定義的表由 oingg-ratios-ts 自己擁有 schema/migration，連到獨立的 oingg-analysis
// Neon 專案（見專案根目錄 .env 的 ANALYSIS_DATABASE_URL / ANALYSIS_DIRECT_URL）。
// 跟 ../schema.prisma（唯讀鏡像 oingg-mops-ts 的季度財報表）是完全不同的資料庫，不要混用連線。
//
// 這裡存的是「算完的投資指標結果」，每個指標各自一張表（ROE、PER、PBR…），
// 不是原始財報資料——原始財報資料一律只在 ../schema.prisma 那三張表查。
//
// 異動這裡的 model 後，用 `pnpm prisma:analysis:migrate` 產生/套用 migration（不要對
// ../schema.prisma 那份跑 migrate，那份永遠只用 db pull 內省）。

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/analysis-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("ANALYSIS_DATABASE_URL")
  directUrl = env("ANALYSIS_DIRECT_URL")
}

// ROE 計算結果——欄位對應 src/domains/profitability/roe/types.ts 的 RoeResult。
model RoeResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  roeQuarterlyPct           Decimal? @map("roe_quarterly_pct") @db.Decimal(10, 2)
  roeQuarterlyAnnualizedPct Decimal? @map("roe_quarterly_annualized_pct") @db.Decimal(10, 2)
  roeTtmPct                 Decimal? @map("roe_ttm_pct") @db.Decimal(10, 2)

  netIncomeFieldUsed String? @map("net_income_field_used")
  netIncomeValue     BigInt? @map("net_income_value")
  equityFieldUsed    String? @map("equity_field_used")
  equityValue        BigInt? @map("equity_value")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("roe_result")
}

// BVPS（每股淨值）計算結果——欄位對應 src/domains/profitability/bvps/types.ts 的 BvpsResult。
model BvpsResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  bvps Decimal? @map("bvps") @db.Decimal(14, 4)

  equityFieldUsed String? @map("equity_field_used")
  equityValue     BigInt? @map("equity_value")

  paidInShares               BigInt? @map("paid_in_shares")
  // capital_stock_history 裡實際套用的那筆紀錄生效於何時（西元年月），不是本季的民國年季。
  capitalStockEffectiveYear  Int?    @map("capital_stock_effective_year")
  capitalStockEffectiveMonth Int?    @map("capital_stock_effective_month")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("bvps_result")
}

// EPS（每股盈餘）計算結果——單季、單季年化、TTM 都是同一張表的欄位（跟 RoeResult 同一種結構），
// 不是各自開表。欄位對應 src/domains/profitability/eps/types.ts 的 EpsResult。
model EpsResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  epsQuarterly           Decimal? @map("eps_quarterly") @db.Decimal(14, 4)
  epsQuarterlyAnnualized Decimal? @map("eps_quarterly_annualized") @db.Decimal(14, 4)
  epsTtm                 Decimal? @map("eps_ttm") @db.Decimal(14, 4)

  netIncomeFieldUsed String? @map("net_income_field_used") // 本季淨利用的是哪個欄位
  netIncomeValue     BigInt? @map("net_income_value") // 本季淨利
  // 近四季（含本季）淨利加總；四季資料不齊則為 null。
  netIncomeTtmValue  BigInt? @map("net_income_ttm_value")

  paidInShares               BigInt? @map("paid_in_shares")
  // capital_stock_history 裡實際套用的那筆紀錄生效於何時（西元年月），不是本季的民國年季。
  capitalStockEffectiveYear  Int?    @map("capital_stock_effective_year")
  capitalStockEffectiveMonth Int?    @map("capital_stock_effective_month")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("eps_result")
}

// 每股營收計算結果——單季、單季年化、TTM 都是同一張表的欄位（跟 RoeResult / EpsResult 同一種結構）。
// 欄位對應 src/domains/profitability/revenuePerShare/types.ts 的 RevenuePerShareResult。
model RevenuePerShareResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  revenuePerShareQuarterly           Decimal? @map("revenue_per_share_quarterly") @db.Decimal(14, 4)
  revenuePerShareQuarterlyAnnualized Decimal? @map("revenue_per_share_quarterly_annualized") @db.Decimal(14, 4)
  revenuePerShareTtm                 Decimal? @map("revenue_per_share_ttm") @db.Decimal(14, 4)

  operatingRevenueValue    BigInt? @map("operating_revenue_value") // 本季營收
  // 近四季（含本季）營收加總；四季資料不齊則為 null。
  operatingRevenueTtmValue BigInt? @map("operating_revenue_ttm_value")

  paidInShares               BigInt? @map("paid_in_shares")
  // capital_stock_history 裡實際套用的那筆紀錄生效於何時（西元年月），不是本季的民國年季。
  capitalStockEffectiveYear  Int?    @map("capital_stock_effective_year")
  capitalStockEffectiveMonth Int?    @map("capital_stock_effective_month")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("revenue_per_share_result")
}

// 每股現金流（OCF/FCF）計算結果——單季、單季年化、TTM 都是同一張表的欄位，OCF 跟 FCF 也共用同一張表
// （不是各自開表），跟 RoeResult / EpsResult 同一種結構。欄位對應
// src/domains/cashFlow/cashFlowPerShare/types.ts 的 CashFlowPerShareResult。
model CashFlowPerShareResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  ocfPerShareQuarterly           Decimal? @map("ocf_per_share_quarterly") @db.Decimal(14, 4)
  ocfPerShareQuarterlyAnnualized Decimal? @map("ocf_per_share_quarterly_annualized") @db.Decimal(14, 4)
  ocfPerShareTtm                 Decimal? @map("ocf_per_share_ttm") @db.Decimal(14, 4)

  // FCF = 營業活動現金流量 + 資本支出（capitalExpenditures 本身是負數，所以是加不是減）。
  fcfPerShareQuarterly           Decimal? @map("fcf_per_share_quarterly") @db.Decimal(14, 4)
  fcfPerShareQuarterlyAnnualized Decimal? @map("fcf_per_share_quarterly_annualized") @db.Decimal(14, 4)
  fcfPerShareTtm                 Decimal? @map("fcf_per_share_ttm") @db.Decimal(14, 4)

  operatingCashFlowValue      BigInt? @map("operating_cash_flow_value") // 本季 netCashFromOperatingActivities
  // 近四季（含本季）加總；四季資料不齊則為 null。
  operatingCashFlowTtmValue   BigInt? @map("operating_cash_flow_ttm_value")
  capitalExpendituresValue    BigInt? @map("capital_expenditures_value") // 本季 capitalExpenditures（負數）
  capitalExpendituresTtmValue BigInt? @map("capital_expenditures_ttm_value") // 近四季加總（負數），資料不齊則為 null

  paidInShares               BigInt? @map("paid_in_shares")
  // capital_stock_history 裡實際套用的那筆紀錄生效於何時（西元年月），不是本季的民國年季。
  capitalStockEffectiveYear  Int?    @map("capital_stock_effective_year")
  capitalStockEffectiveMonth Int?    @map("capital_stock_effective_month")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("cash_flow_per_share_result")
}

// ROA 計算結果——結構跟 RoeResult 一致（單季/年化/TTM 三欄位），分母換成總資產。
// 欄位對應 src/domains/profitability/roa/types.ts 的 RoaResult。
model RoaResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  roaQuarterlyPct           Decimal? @map("roa_quarterly_pct") @db.Decimal(10, 2)
  roaQuarterlyAnnualizedPct Decimal? @map("roa_quarterly_annualized_pct") @db.Decimal(10, 2)
  roaTtmPct                 Decimal? @map("roa_ttm_pct") @db.Decimal(10, 2)

  netIncomeFieldUsed String? @map("net_income_field_used")
  netIncomeValue     BigInt? @map("net_income_value")
  totalAssetsValue   BigInt? @map("total_assets_value")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("roa_result")
}

// 負債比率計算結果——純資產負債表的時點快照，沒有單季/年化/TTM 的區別（不像 RoeResult/RoaResult）。
// 欄位對應 src/domains/solvency/debtRatio/types.ts 的 DebtRatioResult。
model DebtRatioResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  debtRatioPct Decimal? @map("debt_ratio_pct") @db.Decimal(10, 2)

  totalLiabilitiesValue BigInt? @map("total_liabilities_value")
  totalAssetsValue      BigInt? @map("total_assets_value")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("debt_ratio_result")
}

// 流動比率／速動比率計算結果——兩個指標共用同一張表（跟 CashFlowPerShareResult 的 OCF/FCF 一樣的理由：
// 速動比率一定要先有流動資產/流動負債，拆兩支 API 只會重複查同一張資產負債表）。純時點快照，
// 沒有單季/年化/TTM 的區別。欄位對應 src/domains/solvency/liquidityRatio/types.ts 的 LiquidityRatioResult。
model LiquidityRatioResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  currentRatioPct Decimal? @map("current_ratio_pct") @db.Decimal(10, 2)
  quickRatioPct   Decimal? @map("quick_ratio_pct") @db.Decimal(10, 2)
  cashRatioPct    Decimal? @map("cash_ratio_pct") @db.Decimal(10, 2)

  currentAssetsValue      BigInt? @map("current_assets_value")
  currentLiabilitiesValue BigInt? @map("current_liabilities_value")
  inventoryValue          BigInt? @map("inventory_value")
  cashAndEquivalentsValue BigInt? @map("cash_and_equivalents_value")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("liquidity_ratio_result")
}

// 存貨／應收帳款／總資產周轉率計算結果——三個指標共用同一張表（同一組損益表+資產負債表查詢、
// 同一組 TTM 完整性判斷），各自都有單季/年化/TTM 三欄位，跟 RoeResult 同一種結構。
// 欄位對應 src/domains/turnover/turnoverRatio/types.ts 的 TurnoverRatioResult。
model TurnoverRatioResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  inventoryTurnoverQuarterly           Decimal? @map("inventory_turnover_quarterly") @db.Decimal(14, 4)
  inventoryTurnoverQuarterlyAnnualized Decimal? @map("inventory_turnover_quarterly_annualized") @db.Decimal(14, 4)
  inventoryTurnoverTtm                 Decimal? @map("inventory_turnover_ttm") @db.Decimal(14, 4)

  receivablesTurnoverQuarterly           Decimal? @map("receivables_turnover_quarterly") @db.Decimal(14, 4)
  receivablesTurnoverQuarterlyAnnualized Decimal? @map("receivables_turnover_quarterly_annualized") @db.Decimal(14, 4)
  receivablesTurnoverTtm                 Decimal? @map("receivables_turnover_ttm") @db.Decimal(14, 4)

  assetTurnoverQuarterly           Decimal? @map("asset_turnover_quarterly") @db.Decimal(14, 4)
  assetTurnoverQuarterlyAnnualized Decimal? @map("asset_turnover_quarterly_annualized") @db.Decimal(14, 4)
  assetTurnoverTtm                 Decimal? @map("asset_turnover_ttm") @db.Decimal(14, 4)

  fixedAssetTurnoverQuarterly           Decimal? @map("fixed_asset_turnover_quarterly") @db.Decimal(14, 4)
  fixedAssetTurnoverQuarterlyAnnualized Decimal? @map("fixed_asset_turnover_quarterly_annualized") @db.Decimal(14, 4)
  fixedAssetTurnoverTtm                 Decimal? @map("fixed_asset_turnover_ttm") @db.Decimal(14, 4)

  operatingCostValue       BigInt? @map("operating_cost_value") // 本季營業成本
  operatingCostTtmValue    BigInt? @map("operating_cost_ttm_value") // 近四季加總；資料不齊則為 null
  operatingRevenueValue    BigInt? @map("operating_revenue_value") // 本季營收
  operatingRevenueTtmValue BigInt? @map("operating_revenue_ttm_value") // 近四季加總；資料不齊則為 null

  inventoryValue              BigInt? @map("inventory_value") // 本季期末存貨
  accountsReceivableValue     BigInt? @map("accounts_receivable_value") // 本季期末應收帳款
  totalAssetsValue            BigInt? @map("total_assets_value") // 本季期末總資產
  propertyPlantEquipmentValue BigInt? @map("property_plant_equipment_value") // 本季期末不動產、廠房及設備

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("turnover_ratio_result")
}

// 資本支出佔營收比計算結果——「流量/流量」比率，只有單季/TTM 兩種口徑，沒有年化（跟 MarginsResult 同一種結構）。
// 欄位對應 src/domains/turnover/capexToRevenue/types.ts 的 CapexToRevenueResult。
model CapexToRevenueResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  capexToRevenueQuarterly Decimal? @map("capex_to_revenue_quarterly") @db.Decimal(10, 2)
  capexToRevenueTtm       Decimal? @map("capex_to_revenue_ttm") @db.Decimal(10, 2)

  // capitalExpenditures 原始值是負數（現金流出）。
  capitalExpendituresValue    BigInt? @map("capital_expenditures_value")
  capitalExpendituresTtmValue BigInt? @map("capital_expenditures_ttm_value") // 近四季加總（負數）；資料不齊則為 null
  operatingRevenueValue       BigInt? @map("operating_revenue_value")
  operatingRevenueTtmValue    BigInt? @map("operating_revenue_ttm_value") // 近四季加總；資料不齊則為 null

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("capex_to_revenue_result")
}

// 毛利率／營業利益率／稅後淨利率計算結果——三個指標共用同一張表（同一組損益表查詢、同一組 TTM
// 完整性判斷）。這三個都是「流量/流量」比率，本身不需要年化，只有單季/TTM 兩種口徑（沒有
// QuarterlyAnnualized，跟 RoeResult 那種流量對存量的結構不同）。
// 欄位對應 src/domains/profitability/margins/types.ts 的 MarginsResult。
model MarginsResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  grossMarginQuarterly Decimal? @map("gross_margin_quarterly") @db.Decimal(10, 2)
  grossMarginTtm       Decimal? @map("gross_margin_ttm") @db.Decimal(10, 2)

  operatingMarginQuarterly Decimal? @map("operating_margin_quarterly") @db.Decimal(10, 2)
  operatingMarginTtm       Decimal? @map("operating_margin_ttm") @db.Decimal(10, 2)

  netProfitMarginQuarterly Decimal? @map("net_profit_margin_quarterly") @db.Decimal(10, 2)
  netProfitMarginTtm       Decimal? @map("net_profit_margin_ttm") @db.Decimal(10, 2)

  operatingRevenueValue    BigInt? @map("operating_revenue_value") // 本季營收
  operatingRevenueTtmValue BigInt? @map("operating_revenue_ttm_value") // 近四季加總；資料不齊則為 null
  grossProfitValue         BigInt? @map("gross_profit_value")
  grossProfitTtmValue      BigInt? @map("gross_profit_ttm_value")
  operatingIncomeValue     BigInt? @map("operating_income_value")
  operatingIncomeTtmValue  BigInt? @map("operating_income_ttm_value")

  netIncomeFieldUsed String? @map("net_income_field_used") // 本季淨利用的是哪個欄位
  netIncomeValue     BigInt? @map("net_income_value")
  netIncomeTtmValue  BigInt? @map("net_income_ttm_value") // 近四季加總；資料不齊則為 null

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("margins_result")
}

// 負債權益比計算結果——純資產負債表時點快照，沒有單季/年化/TTM 的區別（跟 DebtRatioResult 同一種結構）。
// 欄位對應 src/domains/solvency/deRatio/types.ts 的 DeRatioResult。
model DeRatioResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  deRatioPct Decimal? @map("de_ratio_pct") @db.Decimal(10, 2)

  // 有息負債（短期借款 + 應付公司債 + 長期借款），不是總負債。
  totalDebtValue  BigInt? @map("total_debt_value")
  equityFieldUsed String? @map("equity_field_used")
  equityValue     BigInt? @map("equity_value")

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("de_ratio_result")
}

// 利息保障倍數計算結果——「流量/流量」比率，只有單季/TTM 兩種口徑，沒有年化（跟 MarginsResult 同一種結構）。
// 欄位對應 src/domains/solvency/interestCoverage/types.ts 的 InterestCoverageResult。
model InterestCoverageResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  interestCoverageQuarterly Decimal? @map("interest_coverage_quarterly") @db.Decimal(14, 4)
  interestCoverageTtm       Decimal? @map("interest_coverage_ttm") @db.Decimal(14, 4)

  // EBIT = 稅前淨利 + 利息費用。
  ebitValue               BigInt? @map("ebit_value")
  ebitTtmValue            BigInt? @map("ebit_ttm_value") // 近四季加總；資料不齊則為 null
  interestExpenseValue    BigInt? @map("interest_expense_value")
  interestExpenseTtmValue BigInt? @map("interest_expense_ttm_value") // 近四季加總；資料不齊則為 null

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("interest_coverage_result")
}

// 淨負債對 EBITDA 比計算結果——第一個同時需要查三張財報表的指標（資產負債表算淨負債、
// 損益表+現金流量表算 EBITDA）。淨負債是存量對 EBITDA 流量的比率，taxonomy 只支援 TTM/FY，
// 沒有原始單季版本，只有簡單年化跟 TTM 兩種口徑。
// 欄位對應 src/domains/solvency/netDebtToEbitda/types.ts 的 NetDebtToEbitdaResult。
model NetDebtToEbitdaResult {
  symbol              String
  year                Int    @map("year") // 民國年
  season              Int    @map("season") // 1~4
  dataType            String @map("data_type") // '1' = 個體, '2' = 合併
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime? @map("report_date") @db.Date

  netDebtToEbitdaQuarterlyAnnualized Decimal? @map("net_debt_to_ebitda_quarterly_annualized") @db.Decimal(14, 4)
  netDebtToEbitdaTtm                 Decimal? @map("net_debt_to_ebitda_ttm") @db.Decimal(14, 4)

  // 淨負債 = 有息負債 - 現金及約當現金，可能是負數（淨現金部位）。
  netDebtValue            BigInt? @map("net_debt_value")
  totalDebtValue          BigInt? @map("total_debt_value")
  cashAndEquivalentsValue BigInt? @map("cash_and_equivalents_value")

  // EBITDA = EBIT（稅前淨利+利息費用） + 折舊 + 攤銷。
  ebitdaQuarterlyValue BigInt? @map("ebitda_quarterly_value")
  ebitdaTtmValue       BigInt? @map("ebitda_ttm_value") // 近四季加總；資料不齊則為 null

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, season, dataType, subsidiaryCompanyId])
  @@map("net_debt_to_ebitda_result")
}

// PER/PBR/股利殖利率查詢結果——本服務第一個「不是自己算，而是直接採用外部資料源現成數字」的指標，
// 也是第一個不跟財務季度掛鉤的指標。PER/PBR 是逐日的市場資料（跟 daily_valuation 同一種時間刻度），
// 不是「某季度的數字」——一開始誤把它硬套進 symbol+year+season+dataType+subsidiaryCompanyId
// 那套季度查詢模板，查歷史季度會永遠查不到資料（市場資料的起始日晚於任何已報過的季度），
// 已改成用 symbol+tradeDate 做 PK，跟 oingg-twse daily_valuation 的資料顆粒度一致。
// 數值來自 oingg-twse，本服務不知道對方 EPS 用的口徑，跟自己算的 EPS/BVPS 不保證一致，不要拿來互相驗證。
// 欄位對應 src/domains/valuation/marketRatios/types.ts 的 MarketRatiosResult。
model MarketRatiosResult {
  symbol    String
  tradeDate DateTime @map("trade_date") @db.Date

  peRatio          Decimal? @map("pe_ratio") @db.Decimal(10, 2)
  pbRatio          Decimal? @map("pb_ratio") @db.Decimal(10, 2)
  dividendYieldPct Decimal? @map("dividend_yield_pct") @db.Decimal(10, 2)

  warnings String[]

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, tradeDate])
  @@map("market_ratios_result")
}
